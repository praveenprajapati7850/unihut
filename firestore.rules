rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if (isSignedIn() && request.auth.uid == userId) ||
                               userId.matches('^demo_.*') ||
                               !isSignedIn();
      allow delete: if false;

      // Saved / Favourite listings subcollection
      match /savedListings/{listingId} {
        allow read, write: if (isSignedIn() && request.auth.uid == userId) ||
                              userId.matches('^demo_.*') ||
                              !isSignedIn();
      }
    }

    // Listings
    match /listings/{listingId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.sellerId == request.auth.uid) ||
                       listingId.matches('^seed_listing_.*') ||
                       request.resource.data.sellerId.matches('^demo_.*') ||
                       !isSignedIn();
      allow update: if (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
                       listingId.matches('^seed_listing_.*') ||
                       resource.data.sellerId.matches('^demo_.*') ||
                       !isSignedIn();
      allow delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
                       resource.data.sellerId.matches('^demo_.*') ||
                       !isSignedIn();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.senderId == request.auth.uid) ||
                       request.resource.data.senderId.matches('^demo_.*') ||
                       !isSignedIn();
      allow update: if true;
      allow delete: if false;
    }

    // Offers
    match /offers/{offerId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.buyerId == request.auth.uid) ||
                       request.resource.data.buyerId.matches('^demo_.*') ||
                       !isSignedIn();
      allow update: if (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)) ||
                       resource.data.buyerId.matches('^demo_.*') ||
                       resource.data.sellerId.matches('^demo_.*') ||
                       !isSignedIn();
      allow delete: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Reports
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // User interactions for AI recommendations
    match /userInteractions/{interactionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Wanted Posts
    match /wantedPosts/{wantedPostId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Price Alerts
    match /priceAlerts/{alertId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Campus Handover schedules
    match /handovers/{handoverId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Conversations support
    match /conversations/{conversationId} {
      allow read, write: if true;
      match /messages/{subMessageId} {
        allow read, write: if true;
      }
    }
  }
}
